# QuizQuest Environment Configuration

# Get your API key from: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_actual_api_key_here

# Claude Model Selection (Optional)
# Choose which Claude model to use for quiz generation
# Supported models:
#   - claude-sonnet-4-5-20250929 (64k output tokens) [DEFAULT] - Latest & best coding model
#   - claude-sonnet-4-20250514 (64k output tokens) - Good for large quizzes
#   - claude-opus-4-20250514 (32k output tokens) - Most capable model
#   - claude-3-7-sonnet-20250219 (8k default, 128k with beta) - Extended thinking
#   - claude-haiku-4-5 (8k output tokens) - Fast and efficient
# Default: claude-sonnet-4-5-20250929
# Note: Newer models may have different pricing. For 50-100 questions, use models with higher token limits.
# ANTHROPIC_MODEL=claude-sonnet-4-5-20250929

# Maximum number of questions allowed per quiz (Admin Setting)
# Supported values: 50 or 100
# Default: 50 (if not set)
# Note: Higher values increase API costs proportionally
# For 50+ questions, use claude-sonnet-4-5-20250929 or claude-sonnet-4-20250514 (64k tokens)
MAX_QUESTIONS=50
